APP_NAME=EmployeeEquityManagement
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/equity_management
# 或者使用SQLite
# DATABASE_URL=sqlite:///./equity_management.db

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

SECRET_KEY=your-secret-key-change-in-production-xxxxxxxxxxxxxxxxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

HR_SYSTEM_API_URL=https://hr-system.example.com/api
HR_SYSTEM_API_KEY=your-hr-api-key
HR_SYSTEM_SYNC_INTERVAL_MINUTES=60

STOCK_PRICE_API_URL=https://stock-api.example.com
STOCK_PRICE_API_KEY=your-stock-api-key

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

REPORT_OUTPUT_DIR=./reports
AGREEMENT_TEMPLATE_DIR=./templates/agreements
ARCHIVE_DIR=./archive

MAX_CONCURRENT_EXERCISES=1000
RATE_LIMIT_PER_MINUTE=5000
